      </html>
      <viz type="mitre_attck_heatmap.mitre_attck_heatmap">
        <search>
          <query><![CDATA[| makeresults
| eval id=split("T1589,T1590,T1583,T1584,T1078,T1091,T1047,T1053,T1037,T1006,T1014,T1112,T1207,T1003,T1040,T1007,T1010,T1021,T1072,T1005,T1025,T1001,T1008,T1011,T1020,T1485,T1486,T1001.001,T1001.002,T1001.003,T1003.001,T1003.002,T1003.003,T1003.004,T1003.005,T1003.006,T1003.007,T1003.008,T1011.001,T1020.001,T1021.001,T1021.002,T1021.003,T1021.004,T1021.005,T1021.006,T1021.007,T1021.008,T1059,T1566", ",")
