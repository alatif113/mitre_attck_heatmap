<form version="1.1">
  <label>MITRE Heatmap Test Bench</label>
  <description>Exercises the MITRE ATT&amp;CK Heatmap visualization with generated data, so it works with nothing ingested.</description>
  <init>
    <set token="tok_sub_id">(none)</set>
    <set token="tok_tech_id">(none)</set>
    <set token="tok_tactic_id">(none)</set>
    <set token="tok_sub_name">(none)</set>
    <set token="tok_tech_name">(none)</set>
    <set token="tok_tactic_name">(none)</set>
    <set token="tok_sub_value">(none)</set>
    <set token="tok_tech_value">(none)</set>
    <set token="tok_tactic_value">(none)</set>
  </init>
  <fieldset submitButton="false">
    <input type="dropdown" token="matrix" searchWhenChanged="true">
      <label>Matrix</label>
      <default>enterprise::</default>
      <initialValue>enterprise::</initialValue>
      <choice value="enterprise::">Enterprise - All</choice>
      <choice value="enterprise::Windows">Enterprise - Windows</choice>
      <choice value="enterprise::Linux">Enterprise - Linux</choice>
      <choice value="ics::">ICS (test IDs will not match)</choice>
      <choice value="mobile::">Mobile (test IDs will not match)</choice>
      <choice value="d3fend::">D3FEND (test IDs will not match)</choice>
    </input>
    <input type="radio" token="display" searchWhenChanged="true">
      <label>Display</label>
      <default>id</default>
      <initialValue>id</initialValue>
      <choice value="id">ID</choice>
      <choice value="name">Name</choice>
    </input>
    <input type="radio" token="hide_null" searchWhenChanged="true">
      <label>Hide null</label>
      <default>no</default>
      <initialValue>no</initialValue>
      <choice value="no">No</choice>
      <choice value="yes">Yes</choice>
    </input>
    <input type="checkbox" token="large_toggle" searchWhenChanged="true">
      <label>Stress test</label>
      <choice value="on">Load the 50,000-row panel</choice>
      <delimiter> </delimiter>
      <change>
        <condition value="on">
          <set token="run_large">true</set>
        </condition>
        <condition>
          <unset token="run_large"></unset>
        </condition>
      </change>
    </input>
  </fieldset>
  <row>
    <panel>
      <html>
        <style>
          .mtr-note { margin: 0 0 8px; opacity: 0.8; font-size: 0.9em; }
          .mtr-tokens { border-collapse: collapse; width: 100%; }
          .mtr-tokens th, .mtr-tokens td { text-align: left; padding: 6px 10px; border-bottom: 1px solid rgba(128, 128, 128, 0.4); }
          .mtr-tokens td { font-family: monospace; overflow-wrap: anywhere; }
        </style>
        <p>Every panel below feeds the heatmap with test data from <code>| makeresults</code>, <code>| gentimes</code> or <code>| inputlookup</code>.
        Nothing here needs ingested data. The colors come from the visualization and the surrounding text inherits from the page, so the dashboard reads the same in the light and dark themes.
        The inputs above apply to every panel. The first three data fields are used as technique ID, value and description; extra fields are ignored.</p>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Normal data</title>
      <html>
        <p class="mtr-note">50 technique and sub-technique IDs with values from 0 to 100 and a two-line description on the first row.</p>
      </html>
      <viz type="mitre_attck_heatmap.mitre_attck_heatmap">
        <search>
          <query><![CDATA[| makeresults
| eval id=split("T1589,T1590,T1583,T1584,T1078,T1091,T1047,T1053,T1037,T1006,T1014,T1112,T1207,T1003,T1040,T1007,T1010,T1021,T1072,T1005,T1025,T1001,T1008,T1011,T1020,T1485,T1486,T1001.001,T1001.002,T1001.003,T1003.001,T1003.002,T1003.003,T1003.004,T1003.005,T1003.006,T1003.007,T1003.008,T1011.001,T1020.001,T1021.001,T1021.002,T1021.003,T1021.004,T1021.005,T1021.006,T1021.007,T1021.008,T1059,T1566", ",")
| mvexpand id
| streamstats count AS n
| eval "Detection Count"=(n*37+11)%101
| eval description="Test detections for ".id." (row ".n.")"
| eval description=if(n==1, "First line\\nSecond line of the description", description)
| table id "Detection Count" description]]></query>
          <earliest>-15m</earliest>
          <latest>now</latest>
        </search>
        <option name="height">900</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.matrix">$matrix$</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.display">$display$</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.hideNull">$hide_null$</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.showSubTechniques">yes</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.showSearchBar">yes</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.startVal">0</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.endVal">100</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.sortKey">data-id</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.sortOrder">asc</option>
      </viz>
    </panel>
  </row>
  <row>
    <panel>
      <title>Drilldown</title>
      <html>
        <p class="mtr-note">Click a technique, sub-technique or tactic name. The tokens set by the click are shown below.</p>
      </html>
      <viz type="mitre_attck_heatmap.mitre_attck_heatmap">
        <search>
          <query><![CDATA[| makeresults
| eval id=split("T1589,T1590,T1583,T1584,T1078,T1091,T1047,T1053,T1037,T1006,T1014,T1112,T1207,T1003,T1040,T1007,T1010,T1021,T1072,T1005,T1025,T1001,T1008,T1011,T1020,T1485,T1486,T1001.001,T1001.002,T1001.003,T1003.001,T1003.002,T1003.003,T1003.004,T1003.005,T1003.006,T1003.007,T1003.008,T1011.001,T1020.001,T1021.001,T1021.002,T1021.003,T1021.004,T1021.005,T1021.006,T1021.007,T1021.008,T1059,T1566", ",")
| mvexpand id
| streamstats count AS n
| eval "Detection Count"=(n*37+11)%101
| eval description="Test detections for ".id." (row ".n.")"
| eval description=if(n==1, "First line\\nSecond line of the description", description)
| table id "Detection Count" description]]></query>
          <earliest>-15m</earliest>
          <latest>now</latest>
        </search>
        <option name="height">900</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.matrix">$matrix$</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.display">$display$</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.hideNull">$hide_null$</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.showSubTechniques">yes</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.showSearchBar">yes</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.startVal">0</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.endVal">100</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.sortKey">data-id</option>
        <option name="mitre_attck_heatmap.mitre_attck_heatmap.sortOrder">asc</option>
        <drilldown>
          <set token="tok_sub_id">$row.mtr_sub-technique_id$</set>
          <set token="tok_tech_id">$row.mtr_technique_id$</set>
          <set token="tok_tactic_id">$row.mtr_tactic_id$</set>
          <set token="tok_sub_name">$row.mtr_sub-technique_name$</set>
          <set token="tok_tech_name">$row.mtr_technique_name$</set>
          <set token="tok_tactic_name">$row.mtr_tactic_name$</set>
          <set token="tok_sub_value">$row.mtr_sub-technique_value$</set>
          <set token="tok_tech_value">$row.mtr_technique_value$</set>
          <set token="tok_tactic_value">$row.mtr_tactic_value$</set>
        </drilldown>
      </viz>
    </panel>
  </row>
  <row>
    <panel>
      <title>Drilldown tokens</title>
      <html>
        <p class="mtr-note">Values of the <code>mtr_*</code> drilldown tokens from the last click. A level that does not apply to the click may keep its previous value; the panel starts at (none).</p>
        <table class="mtr-tokens">
          <tr><th>Level</th><th>ID</th><th>Name</th><th>Value</th></tr>
          <tr><th>Sub-technique</th><td>$tok_sub_id|h$</td><td>$tok_sub_name|h$</td><td>$tok_sub_value|h$</td></tr>
          <tr><th>Technique</th><td>$tok_tech_id|h$</td><td>$tok_tech_name|h$</td><td>$tok_tech_value|h$</td></tr>
          <tr><th>Tactic</th><td>$tok_tactic_id|h$</td><td>$tok_tactic_name|h$</td><td>$tok_tactic_value|h$</td></tr>
        </table>
      </html>
    </panel>
  </row>
